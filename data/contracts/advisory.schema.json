{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pulse advisory evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "asset_id",
    "status",
    "reason",
    "data_manifest_sha256",
    "feature_version",
    "model_sha256",
    "policy_version",
    "site_validated"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "advisory",
        "unavailable",
        "degraded"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "data_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feature_version": {
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "site_validated": {
      "const": false
    },
    "rul_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rul_interval_hours": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unavailable",
              "degraded"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "rul_hours": {
            "type": "null"
          },
          "rul_interval_hours": {
            "type": "null"
          }
        }
      }
    }
  ]
}
