%% DME visual scaffold. Adapt labels and topology to supported project evidence.
%% Keep transparent group fills. Add a visible color-role legend to the output.
flowchart TD
  source["Source system"]

  subgraph data["Data foundation"]
    validate["Validate records"]
    records[("Governed records")]
  end

  subgraph analytics["Analytics and models"]
    analyze["Analyze evidence"]
    policy["Apply decision policy"]
  end

  subgraph decisions["Human decisions"]
    review["Review evidence"]
    ledger[("Decision and outcome ledger")]
  end

  source -->|"provides authorized records"| validate
  validate -->|"accepts valid records"| records
  records -->|"supplies versioned inputs"| analyze
  analyze -->|"reports results and uncertainty"| policy
  policy -->|"presents advisory or abstention"| review
  review -->|"records disposition and outcome"| ledger

  classDef sourceRole fill:#EAF3F8,stroke:#356079,stroke-width:1.5px,color:#111111
  classDef dataRole fill:#E5F4F2,stroke:#32746E,stroke-width:1.5px,color:#111111
  classDef analysisRole fill:#EDF0FA,stroke:#42558B,stroke-width:1.5px,color:#111111
  classDef policyRole fill:#F8F2E4,stroke:#876A2D,stroke-width:1.5px,color:#111111
  classDef humanRole fill:#EFF6EB,stroke:#4C713E,stroke-width:1.5px,color:#111111
  classDef evidenceRole fill:#F3F0F8,stroke:#6E5B85,stroke-width:1.5px,color:#111111
  classDef securityRole fill:#FBEFED,stroke:#9B534C,stroke-width:1.5px,color:#111111
  class source sourceRole
  class validate,records dataRole
  class analyze analysisRole
  class policy policyRole
  class review humanRole
  class ledger evidenceRole
  style data fill:none,stroke:#32746E,stroke-width:1.5px,color:#111111
  style analytics fill:none,stroke:#42558B,stroke-width:1.5px,color:#111111
  style decisions fill:none,stroke:#4C713E,stroke-width:1.5px,color:#111111
  linkStyle default stroke:#425466,stroke-width:1.5px
